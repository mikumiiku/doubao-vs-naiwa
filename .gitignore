# 依赖
node_modules/
.pnpm-store/

# 构建产物
dist/
.vite/
*.tsbuildinfo

# 由原始素材生成的运行时资源（pnpm assets:* 生成，不纳入版本库）
public/assets/
public/.tmp-assets/
.cache/

# 环境变量
.env
.env.*
!.env.example

# 日志
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*

# 测试 / 调试产物
.playwright-cli/
coverage/

# 编辑器与 IDE
.vscode/
.idea/
*.swp

# 操作系统
.DS_Store
Thumbs.db

# 本地临时文件
*.local

# 编辑器的原子写入临时产物（vite.config.mjs 里已把这些排除出 watch，
# 否则 Vite 会给临时文件装监听、目录一删就 EBUSY 崩掉 dev server）
.*.tmpdir/
*.tmpdir/
*.tmp
